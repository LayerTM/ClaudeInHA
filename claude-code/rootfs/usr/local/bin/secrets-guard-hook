#!/usr/bin/python3 -I
"""The agent CLI's half of protect_secrets: a PreToolUse hook for every tool call.

The app's CLI configuration requires it for every run. It reads the hook
event as JSON on stdin and looks for the protected files (the list) among the
words of the tool's input: a word that resolves, against the call's working
directory and any `cd` in the same command, to a protected path; or a wildcard
that expands to protected files only. A wildcard or a directory that merely
contains one (a search over the whole configuration) is not aimed at it.

What it does with a hit depends on the level secrets-guard recorded in
/run/secrets-guard-level (never the environment, which the agent could set
for a run of its own; no file: cli-only):
  kernel    the kernel already refuses the file, so the call goes ahead and
            the agent is told why a "Permission denied" will come back, and
            how to add a secret without reading the file. Blocking here would
            only refuse harmless calls that mention a name (a commit message).
  cli-only  this is the only layer: the call is refused (exit status 2, the
            reason on stderr). An event it cannot read is refused too.
A new secret is added by the user: the agent gives the exact line to paste
into secrets.yaml and references it as `!secret NAME`.
  off       every call goes through.
"""
import glob
import json
import os
import re
import shlex
import sys

LIST = "/usr/share/agent-core/protected-paths.txt"
LEVEL_FILE = "/run/secrets-guard-level"
LEVELS = ("kernel", "cli-only", "off")
SEPARATORS = re.compile(r"[\s;|&<>()`'\"=,]+")
WILDCARD = re.compile(r"[*?[]")


def pattern_regex(pattern):
    """AppArmor's globbing: `**` crosses directories, `*` and `?` do not."""
    out = []
    i = 0
    while i < len(pattern):
        if pattern.startswith("**", i):
            out.append(".*")
            i += 2
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    return re.compile("".join(out) + r"\Z")


def load(path):
    """[(pattern, regex)], one absolute path per line."""
    entries = []
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            if not line.startswith("/") or " " in line:
                raise ValueError(f"not an absolute path: {line}")
            entries.append((line, pattern_regex(line)))
    if not entries:
        raise ValueError("the protected list is empty")
    return entries


def strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from strings(item)


def words(text):
    try:
        parts = shlex.split(text, posix=True)
    except ValueError:
        parts = [text]
    for part in parts:
        for word in SEPARATORS.split(part):
            if word:
                yield word


def entry_for(path, entries):
    for entry in entries:
        if entry[1].match(path):
            return entry
    return None


def aimed_at(word, workdir, entries, strict):
    """The protected path a word points at, or None.

    The path is matched as written and as it resolves (a symlink to a
    protected file is that file). A wildcard counts when it expands to
    protected files only — a search over a folder is not aimed at the one file
    in it — unless `strict` (no kernel layer behind this one), when any
    protected match counts.
    """
    path = os.path.normpath(os.path.join(workdir, os.path.expanduser(word)))
    if not WILDCARD.search(word):
        for candidate in (path, os.path.realpath(path)):
            if entry_for(candidate, entries):
                return candidate
        return None
    matches = glob.glob(path)
    hits = [m for m in matches if entry_for(m, entries) or entry_for(os.path.realpath(m), entries)]
    if hits and (strict or len(hits) == len(matches)):
        return hits[0]
    return None


def check(event, entries, strict):
    """The protected path a call names, or None."""
    cwd = event.get("cwd") or "/"
    tool_input = event.get("tool_input")
    workdirs = [cwd]
    if isinstance(tool_input, dict):
        for key in ("workdir", "cwd"):
            if isinstance(tool_input.get(key), str):
                workdirs.append(os.path.join(cwd, tool_input[key]))
    texts = list(strings(tool_input))
    # A `cd` earlier in the same command moves where later words resolve.
    for text in texts:
        found = list(words(text))
        for before, after in zip(found, found[1:]):
            if before == "cd":
                workdirs.extend(os.path.join(wd, after) for wd in list(workdirs))
    for text in texts:
        for word in words(text):
            for workdir in workdirs:
                hit = aimed_at(word, workdir, entries, strict)
                if hit:
                    return hit
    return None


def explain(path):
    text = (
        f"{path} holds Home Assistant credentials, and this app keeps it away from the agent "
        "(protect_secrets): reading or changing it is refused, and a 'Permission denied' on it is that "
        "protection, not a fault to work around. Use the Home Assistant API or the `ha` command instead."
    )
    if os.path.basename(path) == "secrets.yaml":
        text += (
            " To add a secret, do not write the file: give the user the exact line to add to secrets.yaml"
            " (NAME: \"value\") and reference it in the configuration as !secret NAME."
        )
    return text


def recorded_level(path):
    try:
        with open(path, encoding="utf-8") as fh:
            level = fh.read().strip()
    except OSError:
        return "cli-only"
    return level if level in LEVELS else "cli-only"


def main():
    level = recorded_level(sys.argv[2] if len(sys.argv) > 2 else LEVEL_FILE)
    if level == "off":
        return 0
    try:
        entries = load(sys.argv[1] if len(sys.argv) > 1 else LIST)
        hit = check(json.load(sys.stdin), entries, strict=level != "kernel")
    except Exception as exc:  # an unreadable event or list is not a permission
        if level == "kernel":
            return 0
        sys.stderr.write(f"Blocked: the secrets guard could not check this call ({type(exc).__name__}: {exc})\n")
        return 2
    if not hit:
        return 0
    if level == "kernel":
        json.dump({"hookSpecificOutput": {"hookEventName": "PreToolUse", "additionalContext": explain(hit)}}, sys.stdout)
        return 0
    sys.stderr.write("Blocked: " + explain(hit) + "\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
