#!/usr/bin/bash-static
# ==============================================================================
# secrets-guard <command> [args...]
# Runs the app's service with the protection protect_secrets asks for, then
# execs <command>. The s6 `run` script calls it, so everything the service
# starts — the console, its tmux server and every tab, the prompt server and
# each agent it runs — inherits the result. Only s6 itself stays outside.
#
# On (the default, and when the option is absent):
#   kernel    the next exec enters the child profile `guarded` of the app's
#             AppArmor profile (apparmor.txt), which denies every path in the
#             protected list. Root inside the container cannot leave it. The
#             profile name is read from the kernel, because the Supervisor
#             names it after the app's slug.
#   cli-only  a host that runs apps without AppArmor: only the agent's own check
#             of each command (secrets-guard-hook), said loudly in the log.
# The app under any label but its own (the Supervisor did not load its
# profile, or a plain Docker host) runs cli-only, with a warning.
# Only the app's own profile without its guarded mode — a damaged install —
# stops the service (the finish script stops the app) and the log says so.
# Off: nothing is guarded, and the hook lets every call through.
# A start at a lower level than the previous one (kernel > cli-only > off; the
# agent can change the app's options through the Supervisor, a host can lose
# the app's profile) says so: a warning here, and PROTECT_SECRETS_DROPPED /
# PROTECT_SECRETS_DROP_REASON for secrets-guard-notice to raise in Home
# Assistant.
# The level goes to the service's environment as PROTECT_SECRETS_LEVEL, and
# to /run/secrets-guard-level, which the hook reads: a file the guarded mode
# cannot write, where an environment variable could be set by the agent.
#
# Everything here runs BEFORE the guarded mode exists: a static bash (no
# loader, no shared library) named by its path, builtins only. The guarded mode
# can write to PATH directories and, as root, to system libraries — but not to
# this script, the static shell, s6 or options.json (apparmor.txt). Nothing
# this decision runs is a file the agent can change.
# ==============================================================================

log() {
    local level=$1
    shift
    printf '[%(%H:%M:%S)T] %s: %s\n' -1 "${level}" "$*"
}

refuse() {
    log FATAL "Secrets guard: ${1}. The app will not start with protect_secrets on; reinstall the app, or turn the option off to run it without the guard."
    exit 1
}

enabled() {
    local options=""
    options=$(</data/options.json) 2>/dev/null || return 0
    ! [[ "${options}" =~ \"protect_secrets\"[[:space:]]*:[[:space:]]*false ]]
}

cli_only() {
    log WARNING "Secrets guard: ${1}, so the kernel cannot refuse the protected files. Only the agent's own check of each command is on (protect_secrets_level: cli-only)."
    export PROTECT_SECRETS_LEVEL=cli-only
    reason=${1}
}

# kernel > cli-only > off; unknown (no earlier start) ranks below all.
rank() {
    case "${1}" in
        kernel) echo 2 ;;
        cli-only) echo 1 ;;
        off) echo 0 ;;
        *) echo -1 ;;
    esac
}

enter_guarded() {
    local label="" name attr kernel=""
    read -r kernel </sys/module/apparmor/parameters/enabled 2>/dev/null || true
    if [ "${kernel}" != "Y" ]; then
        cli_only "this host runs apps without AppArmor"
        return 0
    fi
    read -r label </proc/self/attr/current 2>/dev/null || true
    name=${label% (*}
    case "${name}" in
        */guarded)
            export PROTECT_SECRETS_LEVEL=kernel
            return 0
            ;;
    esac
    # The Supervisor names the app's profile after its slug and the container
    # after the same slug with - for _ (local_<slug>, local-<slug>). Any other
    # label is not the app's own profile — the Supervisor did not load it, or
    # this is not a Supervisor at all: never a dead app for that, run with the
    # command check and say so.
    if [ -z "${name}" ] || [ "${name//_/-}" != "${HOSTNAME:-}" ]; then
        cli_only "the app does not run under its own AppArmor profile (${name:-no label})"
        return 0
    fi
    for attr in /proc/self/attr/apparmor/exec /proc/self/attr/exec; do
        if [ -e "${attr}" ] && printf 'exec %s//guarded' "${name}" 2>/dev/null >"${attr}"; then
            log INFO "Secrets guard on: the agent cannot read or change the protected files (/usr/share/agent-core/protected-paths.txt; protect_secrets_level: kernel)"
            export PROTECT_SECRETS_LEVEL=kernel
            return 0
        fi
    done
    # The app's own profile without its guarded mode: a damaged install.
    refuse "the app's AppArmor profile (${name}) has no guarded mode"
}

readonly LEVEL_FILE=/run/secrets-guard-level
readonly STATE=/data/secrets-guard-state

previous=""
reason=""
read -r previous <"${STATE}" 2>/dev/null || true
if enabled; then
    enter_guarded
else
    export PROTECT_SECRETS_LEVEL=off
    reason="the protect_secrets option is off"
    log NOTICE "Secrets guard off (protect_secrets): the agent can read every file the app can"
fi
# A start below the previous one is announced once (secrets-guard-notice);
# the stored level then follows, so the same level again is silent.
if [ "$(rank "${PROTECT_SECRETS_LEVEL}")" -lt "$(rank "${previous}")" ]; then
    log WARNING "Secrets protection dropped from ${previous} to ${PROTECT_SECRETS_LEVEL} since the last start: ${reason}"
    export PROTECT_SECRETS_DROPPED="${previous} ${PROTECT_SECRETS_LEVEL}"
    export PROTECT_SECRETS_DROP_REASON="${reason}"
fi
printf '%s\n' "${PROTECT_SECRETS_LEVEL}" >"${LEVEL_FILE}" \
    || [ "${PROTECT_SECRETS_LEVEL}" = off ] || refuse "cannot record the level in ${LEVEL_FILE}"
printf '%s\n' "${PROTECT_SECRETS_LEVEL}" >"${STATE}" 2>/dev/null || true

exec "$@"
