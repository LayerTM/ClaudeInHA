#!/bin/bash
# ==============================================================================
# secrets-guard-notice — tell the owner in Home Assistant that the secrets
# protection is weaker than at the last start.
#
# The agent can change the app's options through the Supervisor (its token has
# the manager role, which the app's Supervisor work needs), and a host can
# start the app without its AppArmor profile, so a lower level cannot always
# be prevented from inside the app. It is made visible instead: secrets-guard
# sets PROTECT_SECRETS_DROPPED="<previous> <now>" and the reason when this
# start is below the previous one, and this raises a persistent notification. It runs in the background and retries while Home Assistant is
# still starting. The agent had the guarded mode until this start and could
# put programs first on PATH (the CLI's directory), or set variables through
# the app's options (HA_NOTIFY_SERVICE would send this elsewhere), to silence
# it. So the notifier is named by its path and runs with a clean environment
# and a fixed PATH; it, the shell libraries it and the start-up source, and
# this file cannot be changed from the guarded mode (apparmor.txt).
# ==============================================================================
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
[ -n "${PROTECT_SECRETS_DROPPED:-}" ] || exit 0
previous=${PROTECT_SECRETS_DROPPED%% *}
now=${PROTECT_SECRETS_DROPPED##* }
reason=${PROTECT_SECRETS_DROP_REASON:-unknown}

if [ "${now}" = off ]; then
    title="Secrets protection was turned off"
    message="The app's secrets protection is off since the last start (${reason}), so the agent can now read secrets.yaml and the other credential files. If you did not turn it off, turn protect_secrets back on in the app's configuration and restart the app."
else
    title="Secrets protection was weakened"
    message="The app's secrets protection dropped from ${previous} to ${now} since the last start: ${reason}. Only the agent's own check of each command is on now, not the kernel's. Reinstalling or updating the app restores its AppArmor profile."
fi

(
    for ((try = 0; try < 40; try++)); do
        /usr/bin/env -i PATH="${PATH}" SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN:-}" \
            /usr/local/bin/ha-notify "${message}" "${title}" >/dev/null 2>&1 && exit 0
        sleep 15
    done
    echo "secrets-guard-notice: could not raise the notification in Home Assistant" >&2
) &
