#!/bin/bash
# ==============================================================================
# secrets-guard-notice — tell the owner in Home Assistant that protect_secrets
# was turned off since the last start.
#
# The agent can change the app's options through the Supervisor (its token has
# the manager role, which the app's Supervisor work needs), so turning the
# protection off cannot be prevented from inside the app. It is made visible
# instead: secrets-guard sets PROTECT_SECRETS_TURNED_OFF=1 when the app starts
# with the option off after a start with it on, and this raises a persistent
# notification. It runs in the background and retries while Home Assistant is
# still starting. The agent had the guarded mode until this start and could
# put programs first on PATH (the CLI's directory), or set variables through
# the app's options (HA_NOTIFY_SERVICE would send this elsewhere), to silence
# it. So the notifier is named by its path and runs with a clean environment
# and a fixed PATH; it, the shell libraries it and the start-up source, and
# this file cannot be changed from the guarded mode (apparmor.txt).
# ==============================================================================
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
[ "${PROTECT_SECRETS_TURNED_OFF:-}" = 1 ] || exit 0

message="The app's protect_secrets option is off since the last start, so the agent can now read secrets.yaml and the other credential files. If you did not turn it off, turn it back on in the app's configuration and restart the app."
title="Secrets protection was turned off"

(
    for ((try = 0; try < 40; try++)); do
        /usr/bin/env -i PATH="${PATH}" SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN:-}" \
            /usr/local/bin/ha-notify "${message}" "${title}" >/dev/null 2>&1 && exit 0
        sleep 15
    done
    echo "secrets-guard-notice: could not raise the notification in Home Assistant" >&2
) &
