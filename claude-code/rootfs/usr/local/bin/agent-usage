#!/usr/bin/env python3
"""Claude Code's console usage, for the core's ha-usage.

Implements ha-agent-core's engine usage-reader contract (adapter API 5):

    agent-usage --files    # the transcript files, NUL-separated
    agent-usage --parse    # one JSON array per stdin line; framing below
    agent-usage --source   # the directory the transcripts are read from

Transcripts are Claude Code's session files under $HOME/.claude/projects
(one JSON object per line). A usage record is built from an assistant
message's ``usage`` block:

    {"day": "YYYY-MM-DD", "model": "...", "input": n, "output": n,
     "cache_read": n, "cache_write": n}

Anthropic's ``input_tokens`` already leaves out the tokens read from cache. A
missing or non-integer count is 0; a message without a timestamp is on day
"unknown", one without a model on model "unknown". A line's record depends
only on that line, so ``--parse`` needs no state across calls.

Prompt API runs are started with ``--no-session-persistence`` and write no
transcript here; the core counts them from its audit log.
"""

from __future__ import annotations

import glob
import json
import os
import sys

HOME = os.environ.get("HOME", "/data/home")
PROJECTS = os.path.join(HOME, ".claude", "projects")

# The report's key for each key of Claude's usage block.
KEYS = (
    ("input", "input_tokens"),
    ("output", "output_tokens"),
    ("cache_read", "cache_read_input_tokens"),
    ("cache_write", "cache_creation_input_tokens"),
)


def _count(value) -> int:
    return int(value) if isinstance(value, int) else 0


def transcripts() -> list[str]:
    return sorted(glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")))


def record(line: str):
    """The usage record for one transcript line, or None."""
    line = line.strip()
    if not line or '"usage"' not in line:
        return None
    try:
        ev = json.loads(line)
    except ValueError:
        return None
    if not isinstance(ev, dict):
        return None
    msg = ev.get("message")
    if not isinstance(msg, dict):
        return None
    usage = msg.get("usage")
    if not isinstance(usage, dict) or "output_tokens" not in usage:
        return None
    ts = ev.get("timestamp")
    ts = ts if isinstance(ts, str) else ""
    model = msg.get("model")
    out = {
        "day": ts[:10] if len(ts) >= 10 else "unknown",
        "model": model if isinstance(model, str) and model else "unknown",
    }
    for short, long in KEYS:
        out[short] = _count(usage.get(long))
    return out


def parse_stdin() -> None:
    out = sys.stdout
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        kind, *rest = json.loads(raw)
        if kind == "S":
            out.write("null\n")
        elif kind == "L":
            rec = record(rest[0])
            out.write(json.dumps([rec] if rec else []) + "\n")
        else:  # "E"
            out.write(json.dumps({"state": None}) + "\n")
        out.flush()


def main(argv: list[str]) -> int:
    if argv == ["--source"]:
        print(PROJECTS)
        return 0
    if argv == ["--files"]:
        sys.stdout.write("".join(f"{path}\0" for path in transcripts()))
        return 0
    if argv == ["--parse"]:
        parse_stdin()
        return 0
    print("usage: agent-usage --files | --parse | --source", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
